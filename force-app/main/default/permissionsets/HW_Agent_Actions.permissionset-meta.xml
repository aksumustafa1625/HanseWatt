<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>HW Agent Actions</label>
    <description>Grants the Agentforce service-agent user runtime access for the HW agent actions: execute the invocables + service classes, and read the data they query (USER_MODE). The "Manage Permissions" grant the activation checklist expects.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses>
        <apexClass>HWExplainConsumptionAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HWConsumptionService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HWIdentifyCustomerAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HWCustomerService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HWGetLatestBillAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HWBillingService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HWCreateCaseAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HWCaseService</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Object reads. Meter_Reading__c/Meter__c/Energy_Bill__c/Contact use viewAll so the
         agent can read any customer's records; Account is read-only (no viewAll — the license
         blocks View All Account) and is needed only to resolve the Meter__r.Account__c lookup. -->
    <objectPermissions>
        <object>Meter_Reading__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Meter__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Account</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Energy_Bill__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Contact</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <!-- Case create: HW Create Case logs a support case for the customer. -->
    <objectPermissions>
        <object>Case</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions><field>Meter_Reading__c.kWh__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Meter_Reading__c.Read_Date__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Meter_Reading__c.Meter__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Meter__c.Account__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Energy_Bill__c.Account__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Energy_Bill__c.Amount__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Energy_Bill__c.Consumption_kWh__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Energy_Bill__c.Period_Start__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Energy_Bill__c.Period_End__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Energy_Bill__c.Status__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Contact.Email</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Case.HW_Topic__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Case.Subject</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Case.Description</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Case.AccountId</field><readable>true</readable><editable>true</editable></fieldPermissions>
</PermissionSet>
