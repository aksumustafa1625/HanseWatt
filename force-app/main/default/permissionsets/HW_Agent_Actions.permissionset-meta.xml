<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>HW Agent Actions</label>
    <description>Grants the Agentforce service-agent user runtime access for HWExplainConsumptionAction: execute the invocable + service class, and read the meter-reading data it queries (USER_MODE). The "Manage Permissions" grant the activation checklist expects.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses>
        <apexClass>HWExplainConsumptionAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>HWConsumptionService</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <objectPermissions>
        <object>Meter_Reading__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Meter__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <!-- Account read is required so USER_MODE can resolve the Meter__c.Account__c lookup
         field (a reference to Account) when the query traverses Meter__r.Account__c. -->
    <objectPermissions>
        <object>Account</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions><field>Meter_Reading__c.kWh__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Meter_Reading__c.Read_Date__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Meter_Reading__c.Meter__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Meter__c.Account__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
</PermissionSet>
