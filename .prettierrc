{
  "trailingComma": "none",
  "plugins": ["prettier-plugin-apex", "@prettier/plugin-xml"],
  "overrides": [
    {
      "files": "*.{cls,trigger}",
      "options": { "parser": "apex", "apexInsertFinalNewline": true }
    },
    {
      "files": "*.{html,xml}",
      "options": { "parser": "xml", "xmlWhitespaceSensitivity": "ignore" }
    }
  ]
}
